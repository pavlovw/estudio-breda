---
import { getSitio } from '../lib/contenido';
import TituloSeccion from './TituloSeccion.astro';
import Modalidades from './Modalidades.astro';
import Divisor from './Divisor.astro';
const sitio = getSitio();
const { clases } = sitio;
const iconos: Record<string, string> = {
  ninos: '<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>',
  jovenes: '<path d="M4 20l3-1 11-11-2-2L5 17z"/><path d="M14 6l2 2"/><path d="M4 20l1-3"/>',
  adultos: '<path d="M18 3c-3 3-7 8-8 11l2 2c3-1 8-5 11-8"/><path d="M10 14c-3 0-4 2-4 4s-1 3-3 3c4 1 8 0 9-3"/>',
};
const colores: Record<string, string> = { ninos: 'var(--ambar)', jovenes: 'var(--menta)', adultos: 'var(--turquesa)' };

// cada paleta con sus colores (manchas de pintura) y una inclinación distinta
const paletas = [
  { acento: 'var(--petroleo)', manchas: ['var(--rojo)', 'var(--ambar)', 'var(--turquesa)'], rot: -1.5 },
  { acento: 'var(--turquesa)', manchas: ['var(--calabaza)', 'var(--primario)', 'var(--menta)'], rot: 1.2 },
  { acento: 'var(--calabaza)', manchas: ['var(--vino)', 'var(--ambar)', 'var(--petroleo)'], rot: -0.8 },
  { acento: 'var(--vino)', manchas: ['var(--turquesa)', 'var(--rojo)', 'var(--arena)'], rot: 1.6 },
];
---

<section class="clases seccion" id="clases">
  <Divisor tipo="rasgado" color="var(--papel-oscuro)" arriba />
  <div class="contenedor">
    <TituloSeccion titulo={clases.titulo} nota={clases.nota} color="var(--turquesa)" colorNota="var(--turquesa)" centrado ruta="clases" />

    <ul class="niveles">
      {
        clases.niveles.map((n, i) => (
          <li class="nivel" data-revelar data-editar={`clases.niveles[${i}]`} style={`--d:${i * 0.12}s; --c:${colores[n.id]}`}>
            <span class="nivel__icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={iconos[n.id]} />
            </span>
            <h3 data-valor={`clases.niveles[${i}].nombre`}>{n.nombre}</h3>
            <p data-valor={`clases.niveles[${i}].descripcion`}>{n.descripcion}</p>
          </li>
        ))
      }
    </ul>

    <Modalidades />

    <div class="planes__pie" data-revelar>
      <div class="planes__incluye">
        <p class="mano">todas las modalidades incluyen</p>
        <ul class="plan__incluye" data-editar="clases.plan.incluye">
          {
            clases.plan.incluye.map((x, i) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 13c2 1 4 4 5 6 3-7 7-11 11-14" />
                </svg>
                <span data-valor={`clases.plan.incluye[${i}]`}>{x}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="planes__botones">
        <a class="boton boton--turquesa" href={sitio.whatsapp} target="_blank" rel="noopener" data-editar="clases.plan.boton,whatsapp">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"/></svg>
          <span data-valor="clases.plan.boton">{clases.plan.boton}</span>
        </a>
        <a class="boton boton--claro" href="/clases">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4M10 12h6M10 16h6"/></svg>
          Pagos, horarios y normas
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .clases {
    background: var(--papel-oscuro) url('/texturas/lienzo.webp');
    background-size: 400px;
    background-blend-mode: soft-light;
  }
  .niveles {
    list-style: none;
    margin: 0 0 clamp(50px, 7vw, 90px);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(20px, 3vw, 34px);
  }
  .nivel {
    position: relative;
    padding: 34px 28px 26px;
    background: #fffdf8;
    border-radius: 18px 26px 14px 30px / 26px 14px 30px 18px;
    box-shadow: var(--sombra-papel);
    transition: transform 0.5s var(--ease-rebote);
  }
  .nivel:hover {
    transform: translateY(-6px) rotate(-1deg);
  }
  .nivel__icono {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    margin-bottom: 14px;
    background: var(--c);
    border-radius: var(--radio-mancha);
    animation: mancha-viva 8s ease-in-out infinite;
  }
  .nivel__icono svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nivel h3 {
    font-size: 1.7rem;
    margin-bottom: 8px;
  }
  .nivel p {
    color: var(--tinta-suave);
    margin: 0;
  }

  /* Lo que incluyen todas + botones */
  .planes__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px 40px;
    margin-top: clamp(30px, 4vw, 46px);
  }
  .planes__incluye {
    display: grid;
    justify-items: center;
  }
  .planes__incluye .mano {
    margin: 0 0 4px;
    font-size: 1.4rem;
    color: var(--turquesa);
  }
  .plan__incluye {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
  }
  .plan__incluye li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .plan__incluye svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--turquesa);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .planes__botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .planes__botones svg {
    width: 20px;
    height: 20px;
  }

</style>
