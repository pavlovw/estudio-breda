---
import { getSitio, formatoPrecio } from '../lib/contenido';
import TituloSeccion from './TituloSeccion.astro';
import Divisor from './Divisor.astro';
const sitio = getSitio();
const { clases } = sitio;
const iconos: Record<string, string> = {
  ninos: '<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>',
  jovenes: '<path d="M4 20l3-1 11-11-2-2L5 17z"/><path d="M14 6l2 2"/><path d="M4 20l1-3"/>',
  adultos: '<path d="M18 3c-3 3-7 8-8 11l2 2c3-1 8-5 11-8"/><path d="M10 14c-3 0-4 2-4 4s-1 3-3 3c4 1 8 0 9-3"/>',
};
const colores: Record<string, string> = { ninos: 'var(--ambar)', jovenes: 'var(--menta)', adultos: 'var(--turquesa)' };
const precio = formatoPrecio(clases.plan.precio, clases.plan.moneda);
---

<section class="clases seccion" id="clases">
  <Divisor tipo="rasgado" color="var(--papel-oscuro)" arriba />
  <div class="contenedor">
    <TituloSeccion titulo={clases.titulo} nota={clases.nota} color="var(--turquesa)" colorNota="var(--turquesa)" centrado ruta="clases" />

    <ul class="niveles">
      {
        clases.niveles.map((n, i) => (
          <li class="nivel" data-revelar data-editar={`clases.niveles[${i}]`} style={`--d:${i * 0.12}s; --c:${colores[n.id]}`}>
            <span class="nivel__icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={iconos[n.id]} />
            </span>
            <h3 data-valor={`clases.niveles[${i}].nombre`}>{n.nombre}</h3>
            <p data-valor={`clases.niveles[${i}].descripcion`}>{n.descripcion}</p>
          </li>
        ))
      }
    </ul>

    <div class="plan" data-revelar>
      <svg class="plan__paleta" viewBox="0 0 600 420" preserveAspectRatio="none" aria-hidden="true">
        <path d="M300 10C470 10 590 90 590 200c0 70-50 95-110 95-45 0-62 28-45 62 20 42-20 55-80 55C130 412 10 330 10 200S130 10 300 10z" />
      </svg>
      <div class="plan__colores" aria-hidden="true">
        <span style="--c:var(--rojo)"></span>
        <span style="--c:var(--calabaza)"></span>
        <span style="--c:var(--primario)"></span>
        <span style="--c:var(--turquesa)"></span>
        <span style="--c:var(--vino)"></span>
      </div>
      <div class="plan__contenido">
        <p class="plan__nombre mano" data-editar="clases.plan.nombre" data-valor="clases.plan.nombre">{clases.plan.nombre}</p>
        <p class="plan__precio" data-editar="clases.plan.precio,clases.plan.periodo">
          <span class="plan__monto" data-valor="clases.plan.precio" data-formato="precio">{precio}</span>
          <span class="plan__periodo mano" data-valor="clases.plan.periodo">{clases.plan.periodo}</span>
        </p>
        <p class="plan__detalle" data-editar="clases.plan.detalle" data-valor="clases.plan.detalle">{clases.plan.detalle}</p>
        <ul class="plan__incluye" data-editar="clases.plan.incluye">
          {
            clases.plan.incluye.map((x, i) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 13c2 1 4 4 5 6 3-7 7-11 11-14" />
                </svg>
                <span data-valor={`clases.plan.incluye[${i}]`}>{x}</span>
              </li>
            ))
          }
        </ul>
        <a class="boton boton--turquesa" href={sitio.whatsapp} target="_blank" rel="noopener" data-editar="clases.plan.boton,whatsapp">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"/></svg>
          <span data-valor="clases.plan.boton">{clases.plan.boton}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .clases {
    background: var(--papel-oscuro) url('/texturas/lienzo.webp');
    background-size: 400px;
    background-blend-mode: soft-light;
  }
  .niveles {
    list-style: none;
    margin: 0 0 clamp(50px, 7vw, 90px);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(20px, 3vw, 34px);
  }
  .nivel {
    position: relative;
    padding: 34px 28px 26px;
    background: #fffdf8;
    border-radius: 18px 26px 14px 30px / 26px 14px 30px 18px;
    box-shadow: var(--sombra-papel);
    transition: transform 0.5s var(--ease-rebote);
  }
  .nivel:hover {
    transform: translateY(-6px) rotate(-1deg);
  }
  .nivel__icono {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    margin-bottom: 14px;
    background: var(--c);
    border-radius: var(--radio-mancha);
    animation: mancha-viva 8s ease-in-out infinite;
  }
  .nivel__icono svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--tinta);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nivel h3 {
    font-size: 1.7rem;
    margin-bottom: 8px;
  }
  .nivel p {
    color: var(--tinta-suave);
    margin: 0;
  }

  /* Tarjeta del plan con forma de paleta de pintor */
  .plan {
    position: relative;
    max-width: 640px;
    margin-inline: auto;
    padding: clamp(48px, 7vw, 70px) clamp(28px, 7vw, 90px) clamp(70px, 9vw, 110px);
  }
  .plan__paleta {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #fbf3e0;
    filter: drop-shadow(0 20px 30px rgba(60, 40, 20, 0.28));
    z-index: 0;
  }
  .plan__colores {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .plan__colores span {
    position: absolute;
    width: clamp(34px, 6vw, 52px);
    aspect-ratio: 1;
    background: var(--c);
    border-radius: var(--radio-mancha);
    box-shadow: inset -4px -6px 0 rgba(0, 0, 0, 0.15), inset 4px 4px 0 rgba(255, 255, 255, 0.3);
    transition: transform 0.5s var(--ease-rebote);
  }
  .plan__colores span:nth-child(1) { top: 9%; left: 22%; }
  .plan__colores span:nth-child(2) { top: 5%; left: 42%; }
  .plan__colores span:nth-child(3) { top: 9%; left: 62%; }
  .plan__colores span:nth-child(4) { top: 22%; right: 6%; }
  .plan__colores span:nth-child(5) { top: 26%; left: 5%; }
  .plan:hover .plan__colores span {
    transform: scale(1.15) rotate(20deg);
  }
  .plan__contenido {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: clamp(28px, 6vw, 50px);
  }
  .plan__nombre {
    font-size: 1.8rem;
    color: var(--rojo);
    margin: 0;
  }
  .plan__precio {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 10px;
    margin: 0;
  }
  .plan__monto {
    font-family: var(--f-titulo);
    font-weight: 800;
    font-size: clamp(3rem, 2rem + 4vw, 4.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .plan__periodo {
    font-size: 1.7rem;
    color: var(--tinta-suave);
  }
  .plan__detalle {
    font-weight: 800;
    color: var(--primario);
    font-size: 1.15rem;
    margin: 6px 0 16px;
  }
  .plan__incluye {
    list-style: none;
    padding: 0;
    margin: 0 auto 26px;
    display: inline-grid;
    gap: 6px;
    text-align: left;
  }
  .plan__incluye li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .plan__incluye svg {
    width: 22px;
    height: 22px;
    flex: none;
    fill: none;
    stroke: var(--turquesa);
    stroke-width: 3;
    stroke-linecap: round;
  }
  @media (max-width: 520px) {
    .plan {
      padding-inline: 22px;
    }
    .plan__paleta {
      inset: 0 -10px;
      width: calc(100% + 20px);
    }
    .plan__colores span:nth-child(4),
    .plan__colores span:nth-child(5) {
      display: none;
    }
  }
</style>
