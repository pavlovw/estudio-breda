---
import { getSitio } from '../lib/contenido';
import TituloSeccion from './TituloSeccion.astro';
const sitio = getSitio();
const c = sitio.contacto;
---

<section class="contacto seccion" id="contacto">
  <div class="mancha" style="--img:url(/texturas/mancha-menta.webp); --w:min(60vw,620px); top:-10%; left:-14%; --o:.5"></div>
  <div class="mancha" style="--img:url(/texturas/mancha-oxido.webp); --w:min(55vw,560px); bottom:-14%; right:-12%; --o:.5; --ad:-8s"></div>
  <div class="mancha" style="--img:url(/texturas/mancha-ambar.webp); --w:min(30vw,300px); top:20%; right:16%; --o:.45; --ad:-3s"></div>

  <div class="contenedor contacto__caja">
    <TituloSeccion titulo={c.titulo} nota={c.nota} color="var(--ambar)" colorNota="var(--vino)" centrado ruta="contacto" />
    <p class="contacto__texto" data-revelar data-editar="contacto.texto" data-valor="contacto.texto">{c.texto}</p>
    <div class="contacto__botones" data-revelar style="--d:.15s">
      <a class="boton boton--turquesa" href={sitio.whatsapp} target="_blank" rel="noopener" data-editar="contacto.botonWhatsapp,whatsapp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"/></svg>
        <span data-valor="contacto.botonWhatsapp">{c.botonWhatsapp}</span>
      </a>
      <a class="boton boton--claro" href={sitio.instagram} target="_blank" rel="noopener" data-editar="contacto.botonInstagram,instagram,instagramUsuario">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
        <span data-valor="contacto.botonInstagram">{c.botonInstagram}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contacto {
    overflow: hidden;
    padding-block: clamp(100px, 13vw, 180px);
  }
  .contacto__caja {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .contacto__texto {
    max-width: 30em;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
  }
  .contacto__botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
</style>
