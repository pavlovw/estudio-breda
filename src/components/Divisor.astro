---
// Borde decorativo entre secciones: pintura que chorrea, papel rasgado u ola.
interface Props {
  tipo?: 'gotas' | 'rasgado' | 'ola';
  color: string;
  pintura?: string;
  arriba?: boolean;
}
const { tipo = 'gotas', color, pintura = 'var(--rojo)', arriba = false } = Astro.props;
const gotas =
  'M0 140 V70 C 60 64 110 76 170 70 C 196 68 204 72 206 92 C 208 118 226 118 228 92 C 230 70 260 66 330 70 C 420 76 470 60 560 68 C 590 70 598 74 600 104 C 602 134 624 134 626 104 C 628 76 650 66 720 70 C 800 74 860 60 930 66 C 956 68 962 72 964 86 C 966 102 982 102 984 86 C 986 70 1020 62 1100 68 C 1170 74 1210 62 1250 66 C 1276 68 1282 76 1284 112 C 1286 138 1308 138 1310 112 C 1312 80 1330 68 1380 68 C 1410 68 1430 70 1440 70 V140 Z';
---

<div class:list={['divisor', `divisor--${tipo}`, { 'divisor--arriba': arriba }]} style={`--fill:${color}; --pintura:${pintura}`} aria-hidden="true">
  {
    tipo === 'gotas' && (
      <svg viewBox="0 0 1440 140" preserveAspectRatio="none">
        <path class="pintura" d={gotas} transform="translate(0 -9)" />
        <path d={gotas} />
        <ellipse class="gota" cx="217" cy="122" rx="5" ry="7" />
        <ellipse class="gota" cx="613" cy="134" rx="6" ry="8" style="animation-delay:-1.4s" />
        <ellipse class="gota" cx="1297" cy="134" rx="5" ry="7" style="animation-delay:-2.6s" />
      </svg>
    )
  }
  {
    tipo === 'rasgado' && (
      <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
        <path d="M0 60 V30 L40 22 L70 34 L120 18 L160 30 L210 20 L250 36 L300 22 L350 30 L390 16 L440 32 L490 24 L540 34 L580 18 L630 28 L690 20 L730 34 L780 22 L830 30 L880 16 L930 32 L980 22 L1030 30 L1080 18 L1120 34 L1170 24 L1220 30 L1270 18 L1320 32 L1370 22 L1410 30 L1440 24 V60 Z" />
      </svg>
    )
  }
  {
    tipo === 'ola' && (
      <svg viewBox="0 0 1440 90" preserveAspectRatio="none">
        <path class="pintura" d="M0 90 V40 C 180 0 320 80 520 46 C 720 12 860 70 1040 44 C 1200 22 1320 30 1440 50 V90 Z" transform="translate(0 -7)" />
        <path d="M0 90 V40 C 180 0 320 80 520 46 C 720 12 860 70 1040 44 C 1200 22 1320 30 1440 50 V90 Z" />
      </svg>
    )
  }
</div>

<style>
  .divisor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    line-height: 0;
    z-index: 2;
    pointer-events: none;
  }
  .divisor--arriba {
    top: -1px;
    bottom: auto;
    transform: scaleY(-1);
  }
  .divisor svg {
    width: 100%;
    height: clamp(50px, 9vw, 130px);
    fill: var(--fill);
    overflow: visible;
  }
  .divisor .pintura,
  .divisor .gota {
    fill: var(--pintura);
  }
  .divisor--rasgado svg {
    height: clamp(24px, 4vw, 50px);
    filter: drop-shadow(0 -3px 2px rgba(60, 40, 20, 0.1));
  }
  .divisor--ola svg {
    height: clamp(40px, 6vw, 90px);
  }
  .gota {
    transform-box: fill-box;
    animation: gotear 3.6s ease-in infinite;
  }
  @keyframes gotear {
    0% { transform: translateY(-14px) scale(0.4); opacity: 0; }
    25% { opacity: 1; transform: translateY(0) scale(1); }
    85% { opacity: 1; }
    100% { transform: translateY(40px) scale(0.9); opacity: 0; }
  }
</style>
