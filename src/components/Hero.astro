---
import { getSitio, getObrasPortada, nombreTecnica, tituloObra } from '../lib/contenido';
import Divisor from './Divisor.astro';
const { hero } = getSitio();
const collage = getObrasPortada().slice(0, 3);
const palabras = hero.titulo.split(' ');
---

<section class="hero" id="inicio">
  <div class="mancha" style="--img:url(/texturas/mancha-menta.webp); --w:min(52vw,560px); top:-6%; left:-12%; --o:.6"></div>
  <div class="mancha" style="--img:url(/texturas/mancha-petroleo.webp); --w:min(46vw,520px); top:8%; right:-14%; --o:.4; --ad:-6s"></div>
  <div class="mancha" style="--img:url(/texturas/mancha-ambar.webp); --w:min(40vw,440px); bottom:2%; left:30%; --o:.4; --ad:-11s"></div>

  <div class="contenedor hero__grid">
    <div class="hero__texto">
      <p class="hero__ante mano">{hero.antetitulo}</p>
      <h1 class="hero__titulo">
        {
          palabras.map((p, i) => (
            <span class:list={['palabra', { destacada: p.toLowerCase() === hero.palabraDestacada }]} style={`--i:${i}`}>
              <span class="palabra__tinta">{p}</span>
              {p.toLowerCase() === hero.palabraDestacada && (
                <svg class="palabra__pincel" viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
                  <path pathLength="1" d="M8 38 C 60 22, 120 46, 180 30 S 270 24, 292 34" />
                </svg>
              )}
            </span>
          ))
        }
      </h1>
      <p class="hero__bajada">{hero.bajada}</p>
      <div class="hero__botones">
        <a class="boton" href="/galeria">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 16l5-5 4 4 3-3 6 6"></path><circle cx="15.5" cy="8.5" r="1.5"></circle></svg>
          {hero.botonPrincipal}
        </a>
        <a class="boton boton--claro" href="#clases">{hero.botonSecundario}</a>
      </div>
    </div>

    <div class="hero__collage" aria-label="Algunas obras de alumnos">
      {
        collage.map((o, i) => (
          <figure class={`cuadro cuadro--${i}`} style={`--prof:${(i + 1) * 0.6}`}>
            <span class="cinta" aria-hidden="true" />
            <img src={o.miniatura} alt={`${tituloObra(o)}, obra de un alumno o alumna del taller`} width={o.ancho / 2} height={o.alto / 2} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption class="mano">{nombreTecnica(o.tecnica)}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <Divisor tipo="gotas" color="var(--papel-claro)" />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: clamp(130px, 17vh, 170px);
    padding-bottom: clamp(90px, 12vw, 160px);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }
  .hero__ante {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    color: var(--rojo);
    margin: 0 0 0.3em;
    transform: rotate(-3deg);
    transform-origin: left;
    animation: aparecer 0.8s 0.1s both;
  }
  .hero__titulo {
    font-size: clamp(2.9rem, 1.6rem + 6vw, 6.4rem);
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin-bottom: 0.4em;
  }
  .palabra {
    position: relative;
    display: inline-block;
    margin-right: 0.22em;
  }
  .palabra__tinta {
    position: relative;
    z-index: 1;
    display: inline-block;
    clip-path: inset(-0.2em 100% -0.3em -0.1em);
    animation: pincelada 0.9s var(--ease-pincel) forwards;
    animation-delay: calc(0.25s + var(--i) * 0.13s);
  }
  .destacada .palabra__tinta {
    font-style: italic;
    color: var(--primario);
  }
  .palabra__pincel {
    position: absolute;
    left: -8%;
    bottom: 0.02em;
    width: 116%;
    height: 0.55em;
    overflow: visible;
  }
  .palabra__pincel path {
    fill: none;
    stroke: var(--ambar);
    stroke-width: 26;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: trazar 0.9s var(--ease-pincel) 1.4s forwards;
  }
  @keyframes pincelada {
    to { clip-path: inset(-0.2em -0.1em -0.3em -0.1em); }
  }
  @keyframes trazar {
    to { stroke-dashoffset: 0; }
  }
  @keyframes aparecer {
    from { opacity: 0; transform: translateY(14px) rotate(-3deg); }
  }

  .hero__bajada {
    max-width: 34em;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
    color: var(--tinta-suave);
    animation: aparecer 0.9s 1.1s both;
  }
  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
    animation: aparecer 0.9s 1.3s both;
  }

  /* Collage de obras */
  .hero__collage {
    position: relative;
    aspect-ratio: 1 / 1.22;
    width: 100%;
    max-width: 500px;
    justify-self: center;
  }
  .cuadro {
    position: absolute;
    margin: 0;
    padding: 12px 12px 8px;
    background: #fffdf8;
    box-shadow: var(--sombra-papel);
    transform: translate(calc(var(--mx, 0) * var(--prof) * 1px), calc(var(--my, 0) * var(--prof) * 1px)) rotate(var(--rot));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: colgar 1.1s var(--ease-rebote) both;
  }
  .cuadro img {
    width: 100%;
    height: auto;
  }
  .cuadro figcaption {
    font-size: 1.2rem;
    text-align: center;
    color: var(--tinta-suave);
    padding-top: 4px;
  }
  .cuadro .cinta {
    top: -14px;
    left: 50%;
    translate: -50% 0;
    rotate: -4deg;
  }
  .cuadro--0 {
    --rot: -5deg;
    width: 52%;
    top: 0;
    left: 0;
    animation-delay: 0.6s;
  }
  .cuadro--1 {
    --rot: 6deg;
    width: 47%;
    top: 6%;
    right: 0;
    animation-delay: 0.85s;
    z-index: 2;
  }
  .cuadro--2 {
    --rot: -2deg;
    width: 50%;
    bottom: 0;
    left: 24%;
    animation-delay: 1.1s;
    z-index: 1;
  }
  @keyframes colgar {
    from { opacity: 0; transform: translateY(-60px) rotate(calc(var(--rot) - 14deg)) scale(0.9); }
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__collage {
      width: min(100%, 460px);
      margin-inline: auto;
    }
  }
</style>

<script>
  // Movimiento suave del collage siguiendo el mouse (solo escritorio)
  const hero = document.querySelector<HTMLElement>('.hero');
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reducido && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let pendiente = false;
    let ex = 0;
    let ey = 0;
    hero.addEventListener('pointermove', (e) => {
      ex = e.clientX;
      ey = e.clientY;
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', String(((ex - r.left) / r.width - 0.5) * -24));
        hero.style.setProperty('--my', String(((ey - r.top) / r.height - 0.5) * -24));
      });
    });
  }
</script>