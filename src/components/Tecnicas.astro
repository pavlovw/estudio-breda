---
import { getSitio } from '../lib/contenido';
import TituloSeccion from './TituloSeccion.astro';
const { tecnicas } = getSitio();
const rot = [-2, 1.5, -1, 2, -1.5, 1, -2.5];
// La dirección de cada textura lleva una huella de su contenido: si la imagen
// cambia, cambia la dirección y ningún navegador muestra una versión vieja.
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const textura = (id: string) => {
  const ruta = `/texturas/tec-${id}.webp`;
  try {
    return `${ruta}?v=${createHash('sha1').update(readFileSync(`public${ruta}`)).digest('hex').slice(0, 8)}`;
  } catch {
    return ruta;
  }
};
---

<section class="tecnicas seccion" id="tecnicas">
  <div class="mancha" style="--img:url(/texturas/mancha-vino.webp); --w:min(50vw,520px); top:10%; right:-10%; --o:.35"></div>
  <div class="contenedor">
    <TituloSeccion titulo={tecnicas.titulo} nota={tecnicas.nota} color="var(--menta)" colorNota="var(--primario)" ruta="tecnicas" />
    <ul class="tecnicas__lista">
      {
        tecnicas.lista.map((t, i) => (
          <li class="tecnica" data-revelar data-editar={`tecnicas.lista[${i}]`} style={`--rot:${rot[i % rot.length]}deg; --d:${(i % 4) * 0.08}s; --tex:url(${textura(t.id)})`}>
            <span class="cinta" aria-hidden="true" />
            <div class="tecnica__muestra" aria-hidden="true" />
            <div class="tecnica__cuerpo">
              <span class="tecnica__num mano">{String(i + 1).padStart(2, '0')}</span>
              <h3 data-valor={`tecnicas.lista[${i}].nombre`}>{t.nombre}</h3>
              <p data-valor={`tecnicas.lista[${i}].descripcion`}>{t.descripcion}</p>
              <a class="tecnica__ver mano" href={`/galeria?tecnica=${t.id}`}>
                ver obras →
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tecnicas {
    overflow: hidden;
    padding-top: clamp(100px, 12vw, 170px);
  }
  .tecnicas__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: clamp(22px, 3vw, 36px);
  }
  .tecnica {
    position: relative;
    background: #fffdf8;
    box-shadow: var(--sombra-papel);
    display: flex;
    flex-direction: column;
    isolation: isolate;
    --x: 50%;
    --y: 0%;
  }
  .tecnica .cinta {
    top: -12px;
    left: 50%;
    translate: -50% 0;
    rotate: 3deg;
    width: 80px;
  }
  .tecnica__muestra {
    position: relative;
    height: 120px;
    background: var(--tex) center / cover;
    overflow: hidden;
  }
  /* La textura se "derrama" sobre la tarjeta desde donde está el cursor */
  .tecnica::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--tex) center / cover;
    opacity: 0.85;
    clip-path: circle(0 at var(--x) var(--y));
    transition: clip-path 0.7s var(--ease-pincel);
  }
  .tecnica:hover::after {
    clip-path: circle(150% at var(--x) var(--y));
  }
  .tecnica__cuerpo {
    position: relative;
    padding: 20px 22px 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
    transition: background 0.4s;
    margin: 0 10px 10px;
    border-radius: 4px;
  }
  .tecnica:hover .tecnica__cuerpo {
    background: rgba(255, 253, 248, 0.92);
  }
  .tecnica__num {
    font-size: 1.4rem;
    color: var(--rojo);
  }
  .tecnica h3 {
    font-size: 1.6rem;
    margin: 2px 0 8px;
  }
  .tecnica p {
    font-size: 0.98rem;
    color: var(--tinta-suave);
    flex: 1;
    margin-bottom: 10px;
  }
  .tecnica__ver {
    align-self: flex-start;
    font-size: 1.35rem;
    color: var(--primario);
    text-decoration: none;
    transition: transform 0.3s var(--ease-rebote);
  }
  .tecnica__ver:hover {
    transform: translateX(6px) rotate(-2deg);
  }
  @media (hover: none) {
    .tecnica__muestra {
      height: 96px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.tecnica').forEach((card) => {
    card.addEventListener('pointerenter', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--x', `${e.clientX - r.left}px`);
      card.style.setProperty('--y', `${e.clientY - r.top}px`);
    });
  });
</script>
