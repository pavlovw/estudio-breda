---
// /clases: modalidades, cómo pagar y las normas del taller, ordenado y fácil de leer.
import Base from '../layouts/Base.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Modalidades from '../components/Modalidades.astro';
import { getSitio } from '../lib/contenido';
import { PAGO, ESENCIAL, SECCIONES, RECUPERABLES } from '../data/reglamento';
const sitio = getSitio();
const indice = [
  { href: '#modalidades', texto: 'Modalidades' },
  { href: '#pago', texto: 'Cómo pagar' },
  ...SECCIONES.map((s) => ({ href: `#${s.id}`, texto: s.titulo })),
];
const datos = [
  { etiqueta: 'Titular', valor: PAGO.titular },
  { etiqueta: 'RUT', valor: PAGO.rut },
  { etiqueta: 'Banco', valor: PAGO.banco },
  { etiqueta: 'Tipo de cuenta', valor: PAGO.tipo },
  { etiqueta: 'N° de cuenta', valor: PAGO.numero, grande: true },
];
const todo = datos.map((d) => `${d.etiqueta}: ${d.valor}`).join('\n');
---

<Base titulo={`Clases, pagos y normas · ${sitio.nombre}`} descripcion="Modalidades y precios, cómo pagar y las normas del Estudio de Arte BREDA.">
  <!-- Cabecera -->
  <section class="cab">
    <div class="mancha" style="--img:url(/texturas/mancha-menta.webp); --w:min(60vw,600px); top:-10%; right:-14%; --o:.5"></div>
    <div class="mancha" style="--img:url(/texturas/mancha-ambar.webp); --w:min(45vw,420px); bottom:-20%; left:-12%; --o:.4; --ad:-6s"></div>
    <div class="contenedor cab__caja">
      <TituloSeccion titulo="Clases, pagos y normas" nota="todo clarito, para que solo te preocupes de crear" color="var(--turquesa)" colorNota="var(--rojo)" nivel="h1" />
      <p class="cab__intro" data-revelar>Aquí están las modalidades, cómo pagar y los acuerdos que hacen que el taller funcione bien para todos.</p>
      <nav class="indice" aria-label="En esta página" data-revelar style="--d:.1s">
        {indice.map((i) => <a href={i.href}>{i.texto}</a>)}
      </nav>
    </div>
  </section>

  <!-- Lo esencial -->
  <section class="esencial" aria-labelledby="t-esencial">
    <div class="contenedor">
      <h2 id="t-esencial" class="mano esencial__titulo">lo esencial, en 10 segundos</h2>
      <ul class="esencial__lista">
        {
          ESENCIAL.map((e, i) => (
            <li data-revelar style={`--d:${i * 0.08}s; --c:${e.color}`}>
              <span class="esencial__num">{e.numero}</span>
              {e.unidad && <span class="esencial__unidad mano">{e.unidad}</span>}
              <span class="esencial__texto">{e.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Modalidades -->
  <section class="bloque" id="modalidades">
    <div class="contenedor">
      <TituloSeccion titulo="Modalidades" nota="elige la que te acomode" color="var(--ambar)" colorNota="var(--turquesa)" centrado />
      <Modalidades />
    </div>
  </section>

  <!-- Cómo pagar -->
  <section class="bloque bloque--papel" id="pago">
    <div class="contenedor">
      <TituloSeccion titulo="Cómo pagar" nota="por transferencia, en 3 pasos" color="var(--menta)" colorNota="var(--rojo)" />
      <div class="pago">
        <ol class="pasos">
          <li data-revelar>
            <span class="pasos__num">1</span>
            <div>
              <h3>Transfiere entre el día 1 y el 6</h3>
              <p>La mensualidad se paga <b>dentro de los primeros 6 días</b> de cada mes, a la cuenta del taller.</p>
            </div>
          </li>
          <li data-revelar style="--d:.1s">
            <span class="pasos__num">2</span>
            <div>
              <h3>Envía el comprobante</h3>
              <p>Mándalo al WhatsApp del taller: <b>{PAGO.whatsapp}</b></p>
              <a class="boton boton--turquesa pasos__boton" href={sitio.whatsapp} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
                Enviar por WhatsApp
              </a>
            </div>
          </li>
          <li data-revelar style="--d:.2s">
            <span class="pasos__num">3</span>
            <div>
              <h3>¿Entras a mitad de mes?</h3>
              <p>Pagas <b>clases individuales</b> hasta completar el mes y, desde el mes siguiente, pasas a la mensualidad.</p>
            </div>
          </li>
        </ol>

        <div class="comprobante" data-revelar style="--d:.15s">
          <span class="cinta" aria-hidden="true"></span>
          <header class="comprobante__cabecera">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10 12 4l9 6M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18"/></svg>
            <div>
              <p class="comprobante__titulo">Datos para transferir</p>
              <p class="mano comprobante__nota">toca "copiar" y pégalo en tu banco</p>
            </div>
          </header>
          <dl class="comprobante__datos">
            {
              datos.map((d) => (
                <div class:list={['dato', { 'dato--grande': d.grande }]}>
                  <dt>{d.etiqueta}</dt>
                  <dd>
                    <span>{d.valor}</span>
                    <button type="button" class="copiar" data-copiar={d.valor} aria-label={`Copiar ${d.etiqueta}`}>copiar</button>
                  </dd>
                </div>
              ))
            }
          </dl>
          <button type="button" class="boton comprobante__todo" data-copiar={todo}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            Copiar todos los datos
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Normas -->
  <section class="bloque" id="normas">
    <div class="contenedor">
      <TituloSeccion titulo="Acuerdos del taller" nota="para que todo fluya" color="var(--calabaza)" colorNota="var(--primario)" />
      <div class="normas">
        {
          SECCIONES.map((s, i) => (
            <article class:list={['norma', { 'norma--aviso': s.tono === 'aviso' }]} id={s.id} data-revelar style={`--d:${(i % 3) * 0.08}s; --c:${s.color}; --rot:${[-0.8, 0.6, -0.4, 0.9, -0.6, 0.4, -0.9][i % 7]}deg`}>
              <header class="norma__cabecera">
                <span class="norma__icono" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={s.icono} />
                </span>
                <h3>{s.titulo}</h3>
              </header>
              {s.id === 'asistencia' && (
                <div class="recupera">
                  <p class="recupera__titulo">Las clases no asistidas <b>no se recuperan</b>, salvo:</p>
                  <ul>
                    {RECUPERABLES.map((r) => (
                      <li>
                        <span aria-hidden="true">✓</span>
                        {r}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <ul class="norma__lista">
                {s.items.map((t) => (
                  <li set:html={t} />
                ))}
              </ul>
              {s.id === 'horarios' && (
                <p class="norma__contacto">
                  Correo: <a href={`mailto:${PAGO.correo}`}>{PAGO.correo}</a>
                </p>
              )}
            </article>
          ))
        }
      </div>

      <div class="cierre" data-revelar>
        <p class="mano">¿Te quedó alguna duda?</p>
        <a class="boton boton--calido" href={sitio.whatsapp} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  b,
  .norma__lista :global(b) {
    font-weight: 800;
    color: var(--tinta);
  }
  /* ---------- Cabecera ---------- */
  .cab {
    position: relative;
    overflow: hidden;
    padding: clamp(130px, 16vw, 180px) 0 clamp(30px, 4vw, 50px);
  }
  .cab__caja {
    position: relative;
    z-index: 1;
  }
  .cab__intro {
    max-width: 38em;
    font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem);
    color: var(--tinta-suave);
  }
  .indice {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .indice a {
    padding: 8px 14px;
    border-radius: 999px;
    border: 2px solid rgba(0, 18, 25, 0.14);
    background: #fffdf8;
    color: var(--tinta);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.3s var(--ease-rebote);
  }
  .indice a:hover {
    border-color: var(--turquesa);
    transform: translateY(-2px) rotate(-1deg);
  }

  /* ---------- Lo esencial ---------- */
  .esencial {
    padding-block: clamp(20px, 3vw, 40px) clamp(50px, 6vw, 80px);
  }
  .esencial__titulo {
    margin: 0 0 14px;
    font-size: 1.7rem;
    color: var(--oxido);
    font-weight: 700;
  }
  .esencial__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .esencial__lista li {
    position: relative;
    display: grid;
    align-content: start;
    padding: 22px 20px 20px;
    background: #fffdf8;
    border-radius: 18px 26px 14px 30px / 26px 14px 30px 18px;
    box-shadow: var(--sombra-papel);
    border-top: 6px solid var(--c);
  }
  .esencial__num {
    font: 900 clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem) / 1 var(--f-titulo);
    color: var(--c);
    letter-spacing: -0.02em;
  }
  .esencial__unidad {
    font-size: 1.3rem;
    color: var(--tinta-suave);
    line-height: 1;
  }
  .esencial__texto {
    margin-top: 8px;
    font-weight: 600;
    line-height: 1.35;
  }

  /* ---------- Bloques ---------- */
  .bloque {
    position: relative;
    padding-block: clamp(60px, 8vw, 110px);
    scroll-margin-top: 80px;
  }
  .bloque--papel {
    background: var(--papel-claro);
  }

  /* ---------- Pago ---------- */
  .pago {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 70px);
    align-items: start;
  }
  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
    counter-reset: paso;
  }
  .pasos li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
  }
  /* línea punteada que une los pasos */
  .pasos li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 25px;
    top: 56px;
    bottom: -18px;
    border-left: 3px dashed rgba(0, 95, 115, 0.3);
  }
  .pasos__num {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: var(--primario);
    color: #fff;
    font: 900 1.5rem var(--f-titulo);
    border-radius: var(--radio-mancha);
  }
  .pasos li:nth-child(2) .pasos__num {
    background: var(--turquesa);
  }
  .pasos li:nth-child(3) .pasos__num {
    background: var(--calabaza);
  }
  .pasos h3 {
    margin: 4px 0 4px;
    font-size: 1.3rem;
  }
  .pasos p {
    margin: 0;
    color: var(--tinta-suave);
  }
  .pasos__boton {
    margin-top: 12px;
  }
  .pasos__boton svg {
    width: 20px;
    height: 20px;
  }

  /* Comprobante con borde de ticket */
  .comprobante {
    --rot: 1deg;
    position: relative;
    padding: 30px clamp(18px, 3vw, 30px) 26px;
    background: #fffdf8 url('/texturas/papel.webp');
    background-size: 512px;
    box-shadow: var(--sombra-papel);
    mask:
      radial-gradient(circle 7px at 11px 0, #0000 97%, #000 100%) top / 22px 51% repeat-x,
      radial-gradient(circle 7px at 11px 100%, #0000 97%, #000 100%) bottom / 22px 51% repeat-x;
  }
  .comprobante .cinta {
    top: 4px;
    right: 20px;
    rotate: 8deg;
  }
  .comprobante__cabecera {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 2px dashed rgba(0, 18, 25, 0.18);
  }
  .comprobante__cabecera svg {
    flex: none;
    width: 44px;
    height: 44px;
    padding: 8px;
    border-radius: 12px;
    background: var(--primario);
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .comprobante__titulo {
    margin: 0;
    font: 800 1.25rem var(--f-titulo);
  }
  .comprobante__nota {
    margin: 0;
    font-size: 1.15rem;
    color: var(--oxido);
  }
  .comprobante__datos {
    margin: 10px 0 18px;
  }
  .dato {
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 18, 25, 0.08);
  }
  .dato dt {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .dato dd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 2px 0 0;
    font-weight: 700;
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }
  .dato--grande dd span {
    font: 900 clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem) var(--f-titulo);
    color: var(--primario);
    letter-spacing: 0.02em;
  }
  .copiar {
    flex: none;
    min-height: 36px;
    padding: 0 12px;
    border: 2px solid rgba(0, 95, 115, 0.3);
    border-radius: 999px;
    background: transparent;
    color: var(--primario);
    font: 700 0.85rem var(--f-texto);
    cursor: pointer;
    transition: background 0.2s;
  }
  .copiar:hover {
    background: rgba(0, 95, 115, 0.08);
  }
  .copiar.copiado,
  .comprobante__todo.copiado {
    background: var(--turquesa);
    border-color: var(--turquesa);
    color: #fff;
  }
  .comprobante__todo {
    width: 100%;
    justify-content: center;
  }
  .comprobante__todo svg {
    width: 20px;
    height: 20px;
  }

  /* ---------- Normas ---------- */
  .normas {
    columns: 3 300px;
    column-gap: clamp(18px, 2.5vw, 28px);
  }
  .norma {
    break-inside: avoid;
    margin-bottom: clamp(18px, 2.5vw, 28px);
    padding: 22px 22px 18px;
    background: #fffdf8;
    border-radius: 18px 26px 14px 30px / 26px 14px 30px 18px;
    box-shadow: var(--sombra-papel);
    scroll-margin-top: 90px;
  }
  .norma--aviso {
    background: #fff4ec;
    outline: 2px dashed color-mix(in srgb, var(--c) 45%, transparent);
    outline-offset: -8px;
  }
  .norma__cabecera {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .norma__icono {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    background: var(--c);
    border-radius: var(--radio-mancha);
  }
  .norma__icono svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .norma h3 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.15;
  }
  .norma__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .norma__lista li {
    position: relative;
    padding-left: 22px;
    color: var(--tinta-suave);
    line-height: 1.45;
  }
  .norma__lista li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.6em;
    width: 9px;
    height: 9px;
    background: var(--c);
    border-radius: var(--radio-mancha);
  }
  .norma__contacto {
    margin: 10px 0 0;
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }
  .norma__contacto a {
    color: var(--primario);
    font-weight: 700;
  }
  .recupera {
    margin-bottom: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c) 10%, #fff);
  }
  .recupera__titulo {
    margin: 0 0 6px;
    font-size: 0.95rem;
  }
  .recupera ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .recupera li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: #fff;
    font-weight: 700;
    font-size: 0.86rem;
  }
  .recupera li span {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    font-size: 0.7rem;
  }

  .cierre {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-top: clamp(20px, 3vw, 40px);
    text-align: center;
  }
  .cierre .mano {
    margin: 0;
    font-size: 1.7rem;
    color: var(--oxido);
  }

  @media (max-width: 900px) {
    .esencial__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pago {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .esencial__lista {
      gap: 10px;
    }
    .esencial__lista li {
      padding: 16px 14px;
    }
  }
</style>

<script>
  // Copiar datos de la cuenta al portapapeles
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    const original = b.innerHTML;
    b.addEventListener('click', async () => {
      const texto = b.dataset.copiar ?? '';
      try {
        await navigator.clipboard.writeText(texto);
      } catch {
        const t = document.createElement('textarea');
        t.value = texto;
        document.body.append(t);
        t.select();
        document.execCommand('copy');
        t.remove();
      }
      b.classList.add('copiado');
      b.textContent = '¡Copiado!';
      setTimeout(() => {
        b.classList.remove('copiado');
        b.innerHTML = original;
      }, 1800);
    });
  });
</script>
